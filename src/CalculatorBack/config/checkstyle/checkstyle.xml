<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Файл не должен содержать табуляцию -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Максимальная длина строки -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- Файл должен заканчиваться переводом строки -->
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">

        <!-- Именование: классы -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Именование: константы -->
        <module name="ConstantName"/>

        <!-- Именование: локальные переменные -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Именование: параметры методов -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Именование: методы -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Именование: поля (допускает _ для Lombok/Spring) -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Импорты: нет звёздочек -->
        <module name="AvoidStarImport"/>

        <!-- Импорты: нет неиспользуемых -->
        <module name="UnusedImports"/>

        <!-- Импорты: нет дублей -->
        <module name="RedundantImport"/>

        <!-- Фигурные скобки: обязательны везде -->
        <module name="NeedBraces"/>

        <!-- Пустой блок catch -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
        </module>

        <!-- Пробел после запятой -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI"/>
        </module>

        <!-- Нет пробела перед запятой -->
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC, ELLIPSIS"/>
        </module>

        <!-- Один оператор на строку -->
        <module name="OneStatementPerLine"/>

        <!-- Объявления переменных: по одной на строку -->
        <module name="MultipleVariableDeclarations"/>

        <!-- Модификаторы в правильном порядке (JLS §8.3.1) -->
        <module name="ModifierOrder"/>

        <!-- Нет лишних модификаторов в интерфейсах -->
        <module name="RedundantModifier"/>

        <!-- Упрощение булевых выражений -->
        <module name="SimplifyBooleanExpression"/>

        <!-- Нет System.out.println -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Использование System.out/err запрещено — используйте логгер"/>
        </module>

        <!-- Длина метода -->
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>

        <!-- Количество параметров метода -->
        <module name="ParameterNumber">
            <property name="max" value="8"/>
        </module>

        <!-- Цикломатическая сложность -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>

        <!-- Пустые строки между элементами класса -->
        <module name="EmptyLineSeparator">
            <property name="tokens"
                value="IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF,
                       STATIC_INIT, INSTANCE_INIT, METHOD_DEF, CTOR_DEF, VARIABLE_DEF, RECORD_DEF"/>
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
        </module>

    </module>
</module>
