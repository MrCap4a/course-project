<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.denis.calculatordesktop.controller.RolesController"
      spacing="0">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Роли" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Добавить роль" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <VBox styleClass="page-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName"        text="Название"        prefWidth="220"/>
                <TableColumn fx:id="colPermissions" text="Права доступа"  prefWidth="460"/>
                <TableColumn fx:id="colActions"     text=""               prefWidth="100"/>
            </columns>
            <placeholder><Label text="Нет ролей"/></placeholder>
        </TableView>
    </VBox>
</VBox>
