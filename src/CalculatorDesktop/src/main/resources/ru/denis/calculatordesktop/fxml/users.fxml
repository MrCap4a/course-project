<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.denis.calculatordesktop.controller.UsersController"
      spacing="0">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Пользователи" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Добавить" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <VBox styleClass="page-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFio"     text="ФИО"    prefWidth="240"/>
                <TableColumn fx:id="colLogin"   text="Логин"  prefWidth="160"/>
                <TableColumn fx:id="colRole"    text="Роль"   prefWidth="180"/>
                <TableColumn fx:id="colActions" text=""       prefWidth="100"/>
            </columns>
            <placeholder><Label text="Нет пользователей"/></placeholder>
        </TableView>
    </VBox>
</VBox>
